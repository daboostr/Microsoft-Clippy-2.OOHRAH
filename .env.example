# TARS Voice — environment configuration
# Copy this file to ".env" and fill in your own Azure values. ".env" is gitignored.
#
# Auth model: Microsoft Entra ID (AAD) via the Azure CLI — NO API keys.
# The resource used has key-based auth disabled; the bridge mints AAD tokens
# through `az account get-access-token`. Just run `az login` before launching.

# Azure AI Foundry / OpenAI endpoint (your Cognitive Services / AI Services resource)
FOUNDRY_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com
FOUNDRY_DEPLOYMENT=gpt-4.1
FOUNDRY_API_VERSION=2024-10-21

# Azure Speech
SPEECH_REGION=<your-region>            # e.g. eastus2
SPEECH_VOICE=en-US-DavisNeural         # any Azure Neural voice

# Full ARM resource ID of the Cognitive Services account (used to build the
# AAD Speech auth token: "aad#<RESOURCE_ID>#<token>").
SPEECH_RESOURCE_ID=/subscriptions/<sub-guid>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<your-resource-name>

# Used by launch-tars.ps1 to target the right Azure context before login
AZURE_SUBSCRIPTION_ID=<sub-guid>
AZURE_TENANT_ID=<tenant-guid>
